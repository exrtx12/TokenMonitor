{
  "name": "ai-usage-widget",
  "version": "0.4.0",
  "description": "claude.ai 사용량을 바탕화면에 보여주는 위젯",
  "author": {
    "name": "TRUE"
  },
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tokenmonitor.aiusagewidget",
    "productName": "AI Usage Widget",
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "services/**/*",
      "widget/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
